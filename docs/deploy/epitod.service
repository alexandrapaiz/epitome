# epitod v1: the reconciler and the ingress. One process that does two small
# things and no large ones:
#
#   1. reads every agent.toml under the roster directory and makes Temporal's
#      schedules match it (create / update / delete). Idempotent, so a restart
#      reconciles instead of duplicating.
#   2. serves the ingress: POST /hooks/<name>, /message/<name>, /window/open,
#      /window/close and GET /healthz, each turning into a workflow start or a
#      signal.
#
# It does NOT execute seats. That is epitod-worker.service, and the split is
# the point: restarting this unit to pick up a roster change cannot interrupt
# a seat that is mid-run.
#
#   sudo cp docs/deploy/epitod.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now epitod
#   sudo systemctl reload epitod        # re-read the roster, reconcile again
#   journalctl -u epitod -f
[Unit]
Description=epitod v1 - reconcile the roster onto Temporal, and serve the ingress
After=network-online.target docker.service epitod-worker.service
Wants=network-online.target

[Service]
Type=simple
User=seats
Group=seats
WorkingDirectory=/srv/asc/state
EnvironmentFile=/srv/asc/env
Environment=EPITO_PORT=4747
ExecStart=/usr/bin/env epito run /srv/asc/roster
# SIGHUP re-reads the roster and reconciles, without dropping the ingress.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=yes
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
