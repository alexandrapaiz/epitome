# An env file shaped like the one on this company's resident host the night the
# daily health post died. Every value here is invented: this directory has
# never held a real credential and this file adds none. What each line is for
# is in cli/test/unit-envfile.mjs, which reads this with both of the product's
# readers and compares them.
EPITO_HOOK_SECRET=0f3ad9c21b7e4a5c
EPITO_PORT=4747

  INDENTED=yes
# the line that killed the unit: a password hash begins with a dollar sign
PASSWORD_HASH=$2b$12$KIXQe1mJ0rZ8wV/3hFq6ue
# the line that put a fragment of a value in a log
WITH_SPACE=hello world
QUOTED="double quoted value"
SQUOTED='single quoted'
BACKTICK=`id`
SUBST=$(id)
HASH_INSIDE=value#notacomment
EMPTY=
; a semicolon comment, which systemd ignores and a shell chokes on
GH_TOKEN
9BAD=nope
not-a-name=nope
TEMPORAL_ADDRESS=127.0.0.1:7233
NO_FINAL_NEWLINE=last